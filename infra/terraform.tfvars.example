# コピーして terraform.tfvars を作る（terraform.tfvars は .gitignore 済み）
#   cp terraform.tfvars.example terraform.tfvars

# 独自ドメインでHTTPS化する場合に指定する
# domain_name = "coworking.example.com"

# ドメインのDNSにNSレコードを追加できない場合（レンタルサーバーのDNSなど）は false にする。
# Route 53を使わず、terraform output dns_records_to_add のCNAMEをDNSに手で追加する
# use_route53 = false

# Sentry（README の「Sentry でエラーを調べる」を参照）
# sentry_dsn_backend  = "https://xxxx@o0.ingest.sentry.io/0"
# sentry_dsn_frontend = "https://yyyy@o0.ingest.sentry.io/0"

# 監視の通知先（README の「監視とSlack通知」を参照）
# slack_team_id    = "T0123456789"
# slack_channel_id = "C0123456789"
# alert_email      = "you@example.com"
# monthly_budget_usd = 80

# サイト全体に Basic 認証をかける（外部の人やボットに見せない）。パスワードは自動で作って SSM に置く
# basic_auth_user     = "ee-office"
# basic_auth_password = "password1122" # 省略すると自動で作る
