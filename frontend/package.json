{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:api": "openapi-typescript ../backend/swagger/v1/openapi.yaml -o src/lib/api-schema.ts && node scripts/gen-ai-tools.mjs",
    "gen:rules": "node scripts/gen-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:booking": "vitest run --config vitest.eval.config.ts evals/booking",
    "eval:analytics": "vitest run --config vitest.eval.config.ts evals/analytics",
    "eval:faq": "vitest run --config vitest.eval.config.ts evals/faq",
    "demo:record": "bash demo/record.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "@sentry/nextjs": "11.16.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
